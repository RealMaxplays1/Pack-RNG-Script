--// PURCHASE DICE + SEEDS
task.spawn(function()
	while true do

		if Settings.Purchase then

			-- Dice
			for _, option in ipairs({
				"Option1",
				"Option2",
				"Option3",
				"Option4"
			}) do

				if not Settings.Purchase then
					break
				end

				Remotes
					:WaitForChild("PurchaseDice")
					:FireServer(option)

				task.wait(1)
			end

			-- Seeds
			for _, option in ipairs({
				"Option1",
				"Option2",
				"Option3",
				"Option4",
				"Option5",
				"Option6"
			}) do

				if not Settings.Purchase then
					break
				end

				Remotes
					:WaitForChild("PurchaseSeed")
					:FireServer(option)

				task.wait(1)
			end
		end

		task.wait(0.1)
	end
end)

--// PLANT SEEDS
task.spawn(function()
	while true do

		if Settings.Plant then

			local seeds = {
				"Epic Seed",
				"Ultra Seed",
				"Insane Seed",
				"Divine Seed"
			}

			for _, seed in ipairs(seeds) do

				for i = 1, 9 do

					if not Settings.Plant then
						break
					end

					Remotes
						:WaitForChild("PlantSeed")
						:FireServer(
							seed,
							"Plant" .. i
						)

					task.wait(1)
				end

				if not Settings.Plant then
					break
				end
			end
		end

		task.wait(0.1)
	end
end)

--// COLLECT PLANTS
task.spawn(function()
	while true do

		if Settings.Collect then

			for i = 1, 9 do

				if not Settings.Collect then
					break
				end

				Remotes
					:WaitForChild("CollectPlant")
					:FireServer(
						"Plant" .. i
					)

				task.wait(1)
			end
		end

		task.wait(0.1)
	end
end)

