local function trackConnection(connection)
    Connections[#Connections + 1] = connection
    return connection
end

local function cleanup()

    if not alive then
        return
    end

    alive = false

    Settings.Auras = false
    Settings.Merchant = false
    Settings.Hatch = false
    Settings.AutoTap = false
    Settings.AutoQuests = false

    for _, connection in ipairs(Connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end

    table.clear(Connections)

    if ScreenGui and ScreenGui.Parent then
        ScreenGui:Destroy()
    end

    if _G.__AUTO_FARM_CLEANUP == cleanup then
        _G.__AUTO_FARM_CLEANUP = nil
    end
end

