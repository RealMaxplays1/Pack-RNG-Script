--// =========================================================
--// QUEST TABLE SEARCH
--// =========================================================

local function looksLikeQuestList(tbl)

    if type(tbl) ~= "table" then
        return false
    end


    local found = 0


    for _, value in pairs(tbl) do

        if type(value) == "table"
            and tonumber(value.Id)
            and value.endAmount ~= nil then

            found += 1

        end

    end


    return found > 0

end


local function findQuestList(
    tbl,
    depth,
    visited
)

    if type(tbl) ~= "table" then
        return nil
    end


    depth = depth or 0
    visited = visited or {}


    if depth > 6
        or visited[tbl] then

        return nil

    end


    visited[tbl] = true


    if looksLikeQuestList(tbl) then
        return tbl
    end


    for _, value in pairs(tbl) do

        if type(value) == "table" then

            local result =
                findQuestList(
                    value,
                    depth + 1,
                    visited
                )


            if result then
                return result
            end

        end

    end


    return nil

end


local function findStat(
    tbl,
    statName,
    depth,
    visited
)

    if type(tbl) ~= "table" then
        return nil
    end


    depth = depth or 0
    visited = visited or {}


    if depth > 6
        or visited[tbl] then

        return nil

    end


    visited[tbl] = true


    if tbl[statName] ~= nil then

        local value =
            tonumber(
                tbl[statName]
            )

        if value ~= nil then
            return value
        end

    end


    for _, value in pairs(tbl) do

        if type(value) == "table" then

            local result =
                findStat(
                    value,
                    statName,
                    depth + 1,
                    visited
                )


            if result ~= nil then
                return result
            end

        end

    end


    return nil

end


--// =========================================================
--// REPLICA DISCOVERY
--// =========================================================

local QuestReplica = nil

local REPLICA_SEARCH_MAX = 5000
local REPLICA_BATCH_SIZE = 100

local ReplicaSearchCursor = 1


local function getReplica(id)

    local success, replica =
        pcall(function()

            return ReplicaController
                .GetReplicaById(id)

        end)


    if success then
        return replica
    end


    return nil

end


local function questReplicaStillValid()

    if not QuestReplica
        or not QuestReplica.Data then

        return false

    end


    return findQuestList(
        QuestReplica.Data
    ) ~= nil

end


local function searchReplicaBatch()

    if questReplicaStillValid() then
        return QuestReplica
    end


    QuestReplica = nil


    for _ = 1, REPLICA_BATCH_SIZE do

        local id =
            ReplicaSearchCursor


        ReplicaSearchCursor += 1


        if ReplicaSearchCursor >
            REPLICA_SEARCH_MAX then

            ReplicaSearchCursor = 1

        end


        local replica =
            getReplica(id)


        if replica
            and replica.Data then

            if findQuestList(
                replica.Data
            ) then

                QuestReplica =
                    replica

                print(
                    "[AutoQuest] Quest replica cached"
                )

                return replica

            end

        end

    end


    return nil

end


local function getCurrentQuests()

    if not questReplicaStillValid() then
        searchReplicaBatch()
    end


    if not QuestReplica then
        return nil
    end


    return findQuestList(
        QuestReplica.Data
    )

end


--// =========================================================
--// CURRENT STAT
--// =========================================================

local function getCurrentStat(statName)

    if not QuestReplica
        or not QuestReplica.Data then

        return 0

    end


    local result =
        findStat(
            QuestReplica.Data,
            statName
        )


    return result or 0

end


local function questComplete(
    quest,
    questInfo
)

    if quest.Collected == true then
        return true
    end


    local current =
        getCurrentStat(
            questInfo.dataType
        )


    local target =
        tonumber(
            quest.endAmount
        ) or 0


    return current >= target

end


--// =========================================================
--// QUEST STATE
--// =========================================================

local QuestState = {

    Eggs = false,

    EternalHatch = false,
    SecretHatch = false,

    Boosts = false,
    Potions = false,
    Fruits = false,

    Auras = false,
    Crates = false,

    Gold = false,
    Rainbow = false

}


local function clearQuestState()

    for key in pairs(QuestState) do
        QuestState[key] = false
    end

end


--// =========================================================
--// QUEST SCANNER
--// =========================================================

local function updateQuestState()

    clearQuestState()


    local quests =
        getCurrentQuests()


    if not quests then
        return
    end


    for _, quest in pairs(quests) do

        if type(quest) ~= "table" then
            continue
        end


        local questInfo =
            SeasonQuests.getQuestData(
                quest.Id
            )


        if not questInfo then
            continue
        end


        if questComplete(
            quest,
            questInfo
        ) then

            continue

        end


        local dataType =
            questInfo.dataType


        -- Ignore TimePlayed
        if dataType == "TimePlayed" then
            continue
        end


        -- Ignore click quests
        if dataType == "UniqueClicks" then
            continue
        end


        if dataType == "Eggs" then

            QuestState.Eggs =
                true


        elseif dataType ==
            "EternalHatched" then

            QuestState.EternalHatch =
                true


        elseif dataType ==
            "SecretHatched" then

            QuestState.SecretHatch =
                true


        elseif dataType ==
            "BoostsUsed" then

            QuestState.Boosts =
                true


        elseif dataType ==
            "PotionsUsed" then

            QuestState.Potions =
                true


        elseif dataType ==
            "AuraChestsOpened" then

            QuestState.Auras =
                true


        elseif dataType ==
            "ShinyCrafted" then

            QuestState.Gold =
                true


        elseif dataType ==
            "RainbowCrafted" then

            QuestState.Rainbow =
                true


        elseif dataType ==
            "TotalCratesOpened" then

            QuestState.Crates =
                true


        elseif dataType ==
            "TotalFruitsUsed" then

            QuestState.Fruits =
                true

        end

    end

end


task.spawn(function()

    while alive do

        if not Settings.AutoQuests then

            clearQuestState()

            task.wait(
                IDLE_DELAY
            )

            continue

        end


        updateQuestState()


        task.wait(
            QUEST_SCAN_DELAY
        )

    end

end)


