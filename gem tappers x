--// =========================================================

local function questComplete(
    quest,
    questInfo
)

    if quest.Collected ==
        true then

        return true
    end


    local current =
        getCurrentStat(
            questInfo.dataType
        )


    local target =
        tonumber(
            quest.endAmount
        ) or 0


    return current >= target
end


--// =========================================================
--// QUEST STATE
--// =========================================================

local QuestState = {

    Eggs = false,

    EternalHatch = false,
    SecretHatch = false,

    Boosts = false,
    Potions = false,
    Fruits = false,

    Auras = false,
    Crates = false,

    Gold = false,
    Rainbow = false

}


local function clearQuestState()

    for key in pairs(QuestState) do

        QuestState[key] =
            false

    end

end


--// =========================================================
--// QUEST SCANNER
--//
--// AURA:
--// 0 = ignore
--// 1 = ignore
--// 2+ = farm
--// =========================================================

local function updateQuestState()

    clearQuestState()


    local quests =
        getCurrentQuests()


    if not quests then
        return
    end


    local auraQuestCount =
        0


    for _, quest in pairs(quests) do

        if type(quest) ~=
            "table" then

            continue
        end


        local questInfo =
            SeasonQuests.getQuestData(
                quest.Id
            )


        if not questInfo then
            continue
        end


        if questComplete(
            quest,
            questInfo
        ) then

            continue
        end


        local dataType =
            questInfo.dataType


        if dataType ==
            "TimePlayed" then

            continue


        elseif dataType ==
            "UniqueClicks" then

            continue


        elseif dataType ==
            "Eggs" then

            QuestState.Eggs =
                true


        elseif dataType ==
            "EternalHatched" then

            QuestState.EternalHatch =
                true


        elseif dataType ==
            "SecretHatched" then

            QuestState.SecretHatch =
                true


        elseif dataType ==
            "BoostsUsed" then

            QuestState.Boosts =
                true


        elseif dataType ==
            "PotionsUsed" then

            QuestState.Potions =
                true


        elseif dataType ==
            "AuraChestsOpened" then

            auraQuestCount += 1


        elseif dataType ==
            "ShinyCrafted" then

            QuestState.Gold =
                true


        elseif dataType ==
            "RainbowCrafted" then

            QuestState.Rainbow =
                true


        elseif dataType ==
            "TotalCratesOpened" then

            QuestState.Crates =
                true


        elseif dataType ==
            "TotalFruitsUsed" then

            QuestState.Fruits =
                true

        end

    end


    -- Need at least 2 active aura quests
    QuestState.Auras =
        auraQuestCount >= 2

end


--// =========================================================
--// QUEST SCANNER WORKER
--// =========================================================

task.spawn(function()

    while alive do

        if not Settings.AutoQuests then

            clearQuestState()

            task.wait(IDLE_DELAY)
            continue

        end


        updateQuestState()


        task.wait(
            QUEST_SCAN_DELAY
        )

    end

end)


