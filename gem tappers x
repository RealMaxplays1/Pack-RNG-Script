local LocalBoostUntil =
    _G.__AUTO_FARM_BOOST_FALLBACK


if not LocalBoostUntil then

    LocalBoostUntil = {}

    _G.__AUTO_FARM_BOOST_FALLBACK =
        LocalBoostUntil

end


local function recentlyUsed(boostName)

    local expiry =
        LocalBoostUntil[
            boostName
        ]

    return expiry
        and os.clock() < expiry

end


local function markBoostUsed(boostName)

    LocalBoostUntil[boostName] =
        os.clock()
        + UNKNOWN_BOOST_RETRY

end


