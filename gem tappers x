--// PROFILE / REPLICA SEARCH
--// =========================================================

local function looksLikeQuestList(tbl)

    if type(tbl) ~= "table" then
        return false
    end

    local amount = 0

    for _, value in pairs(tbl) do

        if type(value) == "table"
            and tonumber(value.Id)
            and value.endAmount ~= nil then

            amount += 1

        end

    end

    return amount > 0
end


local function findQuestList(
    tbl,
    depth,
    visited
)

    if type(tbl) ~= "table" then
        return nil
    end

    depth = depth or 0
    visited = visited or {}

    if depth > 6 or visited[tbl] then
        return nil
    end

    visited[tbl] = true

    if looksLikeQuestList(tbl) then
        return tbl
    end

    for _, value in pairs(tbl) do

        if type(value) == "table" then

            local result =
                findQuestList(
                    value,
                    depth + 1,
                    visited
                )

            if result then
                return result
            end

        end

    end

    return nil
end


local function findStat(
    tbl,
    statName,
    depth,
    visited
)

    if type(tbl) ~= "table" then
        return nil
    end

    depth = depth or 0
    visited = visited or {}

    if depth > 7 or visited[tbl] then
        return nil
    end

    visited[tbl] = true


    if tbl[statName] ~= nil then

        local number =
            tonumber(
                tbl[statName]
            )

        if number then
            return number
        end

    end


    for _, value in pairs(tbl) do

        if type(value) == "table" then

            local result =
                findStat(
                    value,
                    statName,
                    depth + 1,
                    visited
                )

            if result ~= nil then
                return result
            end

        end

    end


    return nil
end


local QuestReplica
local CachedQuestList

local REPLICA_SEARCH_MAX = 5000
local REPLICA_BATCH_SIZE = 100
local ReplicaSearchCursor = 1


local function getReplica(id)

    local success, replica =
        pcall(function()

            return ReplicaController
                .GetReplicaById(id)

        end)

    if success then
        return replica
    end

end


local function searchReplicaBatch()

    if QuestReplica
        and QuestReplica.Data then

        return QuestReplica
    end


    for _ = 1, REPLICA_BATCH_SIZE do

        local id =
            ReplicaSearchCursor

        ReplicaSearchCursor += 1


        if ReplicaSearchCursor >
            REPLICA_SEARCH_MAX then

            ReplicaSearchCursor = 1

        end


        local replica =
            getReplica(id)


        if replica
            and replica.Data then

            local quests =
                findQuestList(
                    replica.Data
                )


            if quests then

                QuestReplica =
                    replica

                CachedQuestList =
                    quests

                return replica

            end

        end

    end

end


local function ensureReplica()

    if QuestReplica
        and QuestReplica.Data then

        return QuestReplica

    end


    for _ = 1, 50 do

        local replica =
            searchReplicaBatch()

        if replica then
            return replica
        end

        task.wait(0.02)

    end

end


local function getCurrentQuests()

    if QuestReplica
        and QuestReplica.Data then

        if CachedQuestList
            and looksLikeQuestList(
                CachedQuestList
            ) then

            return CachedQuestList

        end


        CachedQuestList =
            findQuestList(
                QuestReplica.Data
            )

        return CachedQuestList

    end


    searchReplicaBatch()

    return CachedQuestList
end


local function getCurrentStat(name)

    if not QuestReplica
        or not QuestReplica.Data then

        return 0
    end

    return
        findStat(
            QuestReplica.Data,
            name
        )
        or 0

end


--// =========================================================
--// AUTO BOOST ACTIVE DETECTION
--// =========================================================

local function normalize(text)

    return string.lower(
        tostring(text)
    ):gsub(
        "[^%w]",
        ""
    )

end


local ActiveIndicators = {
    "activeboost",
    "activepotion",
    "boosttimer",
    "boosttime",
    "potiontimer",
    "potiontime",
    "fruitboost",
    "remaining",
    "duration",
    "timeleft",
    "expires",
    "active"
}


local function hasActiveIndicator(path)

    local normalized =
        normalize(path)

    for _, indicator in ipairs(
        ActiveIndicators
    ) do

        if string.find(
            normalized,
            indicator,
            1,
            true
        ) then

            return true

        end

    end

    return false
end


local function scalarActive(value)

    if type(value) == "boolean" then
        return value
    end


    if type(value) == "number" then
        return value > 0
    end


    if type(value) == "string" then

        local lower =
            string.lower(value)

        if lower == "true"
            or lower == "active" then

            return true
        end

        local number =
            tonumber(value)

        if number then
            return number > 0
        end

    end


    return nil
end


local function scanBoostState(
    tbl,
    boostName,
    path,
    depth,
    visited
)

    if type(tbl) ~= "table" then
        return nil
    end


    depth = depth or 0
    visited = visited or {}


    if depth > 9
        or visited[tbl] then

        return nil
    end


    visited[tbl] = true


    local target =
        normalize(boostName)


    for key, value in pairs(tbl) do

        local currentPath =
            path ..
            "." ..
            tostring(key)


        local keyNorm =
            normalize(key)


        local pathNorm =
            normalize(currentPath)


        local nameMatch =
            keyNorm == target
            or string.find(
                keyNorm,
                target,
                1,
                true
            )
            or string.find(
                pathNorm,
                target,
                1,
                true
            )


        if nameMatch
            and hasActiveIndicator(
                currentPath
            ) then


            if type(value) ~= "table" then

                local state =
                    scalarActive(value)

                if state ~= nil then
                    return state
                end


            else

                -- Common timer/active fields
                for subKey, subValue in pairs(value) do

                    local subNorm =
                        normalize(subKey)


                    if string.find(
                        subNorm,
                        "active",
                        1,
                        true
                    )
                    or string.find(
                        subNorm,
                        "time",
                        1,
                        true
                    )
                    or string.find(
                        subNorm,
                        "duration",
                        1,
                        true
                    )
                    or string.find(
                        subNorm,
                        "remaining",
                        1,
                        true
                    ) then

                        local state =
                            scalarActive(
                                subValue
                            )

                        if state ~= nil then
                            return state
                        end

                    end

                end

            end

        end


        if type(value) == "table" then

            local result =
                scanBoostState(
                    value,
                    boostName,
                    currentPath,
                    depth + 1,
                    visited
                )


            if result ~= nil then
                return result
            end

        end

    end


    return nil
end


local function getBoostState(boostName)

    if not QuestReplica
        or not QuestReplica.Data then

        return nil
    end


    return scanBoostState(
