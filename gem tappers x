--// =========================================================
--// DATA HELPERS
--// =========================================================

local function normalize(value)

    return string.lower(
        tostring(value)
    ):gsub(
        "[^%w]",
        ""
    )

end


local function looksLikeQuestList(tbl)

    if type(tbl) ~= "table" then
        return false
    end


    local found = 0


    for _, value in pairs(tbl) do

        if type(value) == "table"
            and tonumber(value.Id)
            and value.endAmount ~= nil then

            found += 1

        end

    end


    return found > 0

end


local function findQuestList(
    tbl,
    depth,
    visited
)

    if type(tbl) ~= "table" then
        return nil
    end


    depth =
        depth or 0


    visited =
        visited or {}


    if depth > 6
        or visited[tbl] then

        return nil

    end


    visited[tbl] =
        true


    if looksLikeQuestList(tbl) then
        return tbl
    end


    for _, value in pairs(tbl) do

        if type(value) == "table" then

            local result =
                findQuestList(
                    value,
                    depth + 1,
                    visited
                )


            if result then
                return result
            end

        end

    end


    return nil

end


local function findStat(
    tbl,
    statName,
    depth,
    visited
)

    if type(tbl) ~= "table" then
        return nil
    end


    depth =
        depth or 0


    visited =
        visited or {}


    if depth > 8
        or visited[tbl] then

        return nil

    end


    visited[tbl] =
        true


    if tbl[statName] ~= nil then

        local value =
            tonumber(
                tbl[statName]
            )


        if value ~= nil then
            return value
        end

    end


    for _, value in pairs(tbl) do

        if type(value) == "table" then

            local result =
                findStat(
                    value,
                    statName,
                    depth + 1,
                    visited
                )


            if result ~= nil then
                return result
            end

        end

    end


    return nil

end


--// =========================================================
--// PLAYER / QUEST REPLICA
--// =========================================================

local QuestReplica = nil
local CachedQuestList = nil

local REPLICA_SEARCH_MAX = 5000
local REPLICA_BATCH_SIZE = 100
local ReplicaSearchCursor = 1


local function getReplica(id)

    local success, replica =
        pcall(function()

            return ReplicaController
                .GetReplicaById(id)

        end)


    if success then
        return replica
    end


    return nil

end


local function searchQuestReplicaBatch()

    if QuestReplica
        and QuestReplica.Data then

        if CachedQuestList
            and looksLikeQuestList(
                CachedQuestList
            ) then

            return QuestReplica

        end


        CachedQuestList =
            findQuestList(
                QuestReplica.Data
            )


        if CachedQuestList then
            return QuestReplica
        end

    end


    for _ = 1, REPLICA_BATCH_SIZE do

        local id =
            ReplicaSearchCursor


        ReplicaSearchCursor +=
            1


        if ReplicaSearchCursor >
            REPLICA_SEARCH_MAX then

            ReplicaSearchCursor =
                1

        end


        local replica =
            getReplica(id)


        if replica
            and replica.Data then

            local quests =
                findQuestList(
                    replica.Data
                )


            if quests then

                QuestReplica =
                    replica


                CachedQuestList =
                    quests


                print(
                    "[Auto Farm] Player replica:",
                    id
                )


                return replica

            end

        end

    end


    return nil

end


local function ensureQuestReplica(
    fullSearch
)

    if QuestReplica
        and QuestReplica.Data then

        return QuestReplica

    end


    local batches =
        fullSearch and 50 or 2


    for _ = 1, batches do

        local replica =
            searchQuestReplicaBatch()


        if replica then
            return replica
        end


        task.wait(
            0.02
        )

    end


    return nil

end


local function getCurrentQuests()

    if QuestReplica
        and QuestReplica.Data then

        if CachedQuestList
            and looksLikeQuestList(
                CachedQuestList
            ) then

            return CachedQuestList

        end


        CachedQuestList =
            findQuestList(
                QuestReplica.Data
            )


        if CachedQuestList then
            return CachedQuestList
        end

    end


    searchQuestReplicaBatch()


    return CachedQuestList

end


local function getCurrentStat(
    statName
)

    if not QuestReplica
        or not QuestReplica.Data then

        return 0

    end


    return
        findStat(
            QuestReplica.Data,
            statName
        )
        or 0

end


