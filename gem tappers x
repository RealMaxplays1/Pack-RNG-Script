--// =========================================================
--// QUEST AURAS
--//
--// Requires 2+ unfinished aura quests.
--//
--// Basic
--// Epic
--// Icy
--// Emerald
--// Magma
--// Galaxy
--// -> Basic again
--// =========================================================

task.spawn(function()

    while alive do

        if not Settings.AutoQuests
            or not QuestState.Auras then

            task.wait(
                IDLE_DELAY
            )

            continue

        end


        for _, aura in ipairs(
            AuraPriority
        ) do

            if not alive
                or not Settings.AutoQuests
                or not QuestState.Auras then

                break

            end


            pcall(function()

                Functions
                    :WaitForChild("AurasFunction")
                    :InvokeServer(
                        aura
                    )

            end)


            task.wait(
                QUEST_AURA_TIER_DELAY
            )

        end


        task.wait(
            QUEST_AURA_CYCLE_DELAY
        )

    end

end)


