--// =========================================================
--// QUEST TABLE SEARCH
--// =========================================================

local function looksLikeQuestList(tbl)

    if type(tbl) ~= "table" then
        return false
    end


    local found = 0


    for _, value in pairs(tbl) do

        if type(value) == "table"
            and tonumber(value.Id)
            and value.endAmount ~= nil then

            found += 1

        end

    end


    return found > 0

end


local function findQuestList(
    tbl,
    depth,
    visited
)

    if type(tbl) ~= "table" then
        return nil
    end


    depth = depth or 0
    visited = visited or {}


    if depth > 6 then
        return nil
    end


    if visited[tbl] then
        return nil
    end


    visited[tbl] = true


    if looksLikeQuestList(tbl) then
        return tbl
    end


    for _, value in pairs(tbl) do

        if type(value) == "table" then

            local result =
                findQuestList(
                    value,
                    depth + 1,
                    visited
                )


            if result then
                return result
            end

        end

    end


    return nil

end


--// =========================================================
--// STAT SEARCH
--// =========================================================

local function findStat(
    tbl,
    statName,
    depth,
    visited
)

    if type(tbl) ~= "table" then
        return nil
    end


    depth = depth or 0
    visited = visited or {}


    if depth > 6 then
        return nil
    end


    if visited[tbl] then
        return nil
    end


    visited[tbl] = true


    if tbl[statName] ~= nil then

        local value =
            tonumber(tbl[statName])


        if value then
            return value
        end

    end


    for _, value in pairs(tbl) do

        if type(value) == "table" then

            local result =
                findStat(
                    value,
                    statName,
                    depth + 1,
                    visited
                )


            if result ~= nil then
                return result
            end

        end

    end


    return nil

end


--// =========================================================
--// REPLICA
--// =========================================================

local QuestReplica = nil
local StatReplicaCache = {}


local function getReplica(id)

    local success, replica =
        pcall(function()

            return ReplicaController.GetReplicaById(id)

        end)


    if success then
        return replica
    end


    return nil

end


local function discoverQuestReplica()

    if QuestReplica
        and QuestReplica.Data
        and findQuestList(QuestReplica.Data) then

        return QuestReplica

    end


    for id = 1, 5000 do

        local replica =
            getReplica(id)


        if replica
            and replica.Data then

            local quests =
                findQuestList(
                    replica.Data
                )


            if quests then

                QuestReplica =
                    replica

                print(
                    "[AutoQuest] Quest data found"
                )

                return replica

            end

        end


        if id % 250 == 0 then
            task.wait()
        end

    end


    return nil

end


local function getCurrentQuests()

    local replica =
        discoverQuestReplica()


    if not replica then
        return nil
    end


    return findQuestList(
        replica.Data
    )

end


local function getCurrentStat(statName)

    -- Cached replica
    local cached =
        StatReplicaCache[statName]


    if cached
        and cached.Data then

        local result =
            findStat(
                cached.Data,
                statName
            )


        if result ~= nil then
            return result
        end

    end


    -- Quest replica first
    if QuestReplica
        and QuestReplica.Data then

        local result =
            findStat(
                QuestReplica.Data,
                statName
            )


        if result ~= nil then

            StatReplicaCache[statName] =
                QuestReplica

            return result

        end

    end


    -- Search all replicas
    for id = 1, 5000 do

        local replica =
            getReplica(id)


        if replica
            and replica.Data then

            local result =
                findStat(
                    replica.Data,
                    statName
                )


            if result ~= nil then

                StatReplicaCache[statName] =
                    replica

                return result

            end

        end


        if id % 250 == 0 then
            task.wait()
        end

    end


    return 0

end


--// =========================================================
--// QUEST COMPLETE CHECK
--// =========================================================

local function questComplete(
    quest,
    questInfo
)

    if quest.Collected == true then
        return true
    end


    local current =
        getCurrentStat(
            questInfo.dataType
        )


    local target =
        tonumber(
            quest.endAmount
        ) or 0


    return current >= target

end


--// =========================================================
--// SAFE ACTION
--// Prevents the same remote action stacking
--// =========================================================

local function runAction(
    actionName,
    callback
)

    if ActionBusy[actionName] then
        return
    end


    ActionBusy[actionName] =
        true


    task.spawn(function()

        pcall(callback)

        ActionBusy[actionName] =
            false

    end)

end


