if not SessionBaseline then

    SessionBaseline = {
        Initialized = false,
        Eggs = 0,
        Secrets = 0,
        Divines = 0
    }


    _G.__AUTO_FARM_SESSION_BASELINE =
        SessionBaseline

end


local function statCandidates(list)

    for _, name in ipairs(list) do

        local value =
            QuestReplica
            and QuestReplica.Data
            and findStat(
                QuestReplica.Data,
                name
            )

        if value ~= nil then
            return value
        end

    end

end


local function rawStats()

    return

        statCandidates({
            "Eggs",
            "EggsHatched",
            "EggsOpened",
            "TotalEggsHatched"
        }),

        statCandidates({
            "SecretHatched",
            "SecretsHatched",
            "Secrets"
        }),

        statCandidates({
            "DivineHatched",
            "DivinesHatched",
            "Divines"
        })

end


local function initializeStats()

    if SessionBaseline.Initialized then
        return
    end


    ensureReplica()


    local eggs, secrets, divines =
        rawStats()


    SessionBaseline.Eggs =
        eggs or 0

    SessionBaseline.Secrets =
        secrets or 0

    SessionBaseline.Divines =
        divines or 0

    SessionBaseline.Initialized =
        true

end


local function updateStats()

    initializeStats()


    local eggs, secrets, divines =
        rawStats()


    EggsStat.Text =
        "Eggs: +" ..
        tostring(
            math.max(
                0,
                (eggs or SessionBaseline.Eggs)
                - SessionBaseline.Eggs
            )
        )


    SecretStat.Text =
        "Secrets: +" ..
        tostring(
            math.max(
                0,
                (secrets or SessionBaseline.Secrets)
                - SessionBaseline.Secrets
            )
        )


    DivineStat.Text =
        "Divines: +" ..
        tostring(
            math.max(
                0,
                (divines or SessionBaseline.Divines)
                - SessionBaseline.Divines
            )
        )


    StatsUpdated.Text =
        "Session • updates every 60s"

end


