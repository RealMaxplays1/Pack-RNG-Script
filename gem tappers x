        )


    FruitIndex += 1


    if FruitIndex >
        #FruitItems then

        FruitIndex = 1

    end

end


local function QuestUsePotion()

    local item =
        PotionItems[
            PotionIndex
        ]


    Events
        :WaitForChild("UsePotion")
        :FireServer(
            item,
            1
        )


    PotionIndex += 1


    if PotionIndex >
        #PotionItems then

        PotionIndex = 1

    end

end


local function QuestCraft(craftType)

    Functions
        :WaitForChild("CraftAllStacks")
        :InvokeServer(
            craftType
        )

end


local function QuestOpenCrate()

    Events
        :WaitForChild("OpenCrate")
        :InvokeServer(
            "fruitsBox",
            1
        )

end


--// =========================================================
--// SCAN ALL QUESTS
--// =========================================================

local function getRequiredQuestActions()

    local quests =
        getCurrentQuests()


    if not quests then
        return nil
    end


    local actions = {

        Eggs = false,
        RarityHatch = false,

        Boosts = false,
        Potions = false,
        Fruits = false,

        Auras = false,
        Crates = false,

        Gold = false,
        Rainbow = false

    }


    for _, quest in pairs(quests) do

        if type(quest) == "table" then

            local questInfo =
                SeasonQuests.getQuestData(
                    quest.Id
                )


            if questInfo then

                local dataType =
                    questInfo.dataType


                if not questComplete(
                    quest,
                    questInfo
                ) then


                    -- Ignore AFK quest
                    if dataType ==
                        "TimePlayed" then


                    -- Ignore clicks
                    elseif dataType ==
                        "UniqueClicks" then


                    -- Open eggs
                    elseif dataType ==
                        "Eggs" then

                        actions.Eggs =
                            true


                    -- Eternal / Mythical / Secret
                    elseif dataType ==
                        "EternalHatched"

                        or dataType ==
                        "MythicalHatched"

                        or dataType ==
                        "SecretHatched"
                    then

                        actions.RarityHatch =
                            true


                    -- Boost quest
                    elseif dataType ==
                        "BoostsUsed"
                    then

                        actions.Boosts =
                            true


                    -- Potion quest
                    elseif dataType ==
                        "PotionsUsed"
                    then

                        actions.Potions =
                            true


                    -- Aura quest
                    elseif dataType ==
                        "AuraChestsOpened"
                    then

                        actions.Auras =
                            true


                    -- Gold pets
                    elseif dataType ==
                        "ShinyCrafted"
                    then

                        actions.Gold =
                            true


                    -- Rainbow pets
                    elseif dataType ==
                        "RainbowCrafted"
                    then

                        actions.Rainbow =
                            true


                    -- Crates
                    elseif dataType ==
                        "TotalCratesOpened"
                    then

                        actions.Crates =
                            true


                    -- Fruits
                    elseif dataType ==
                        "TotalFruitsUsed"
                    then

                        actions.Fruits =
                            true

                    end

                end

            end

        end

    end


    return actions

end


--// =========================================================
--// MULTI AUTO QUEST LOOP
--// =========================================================

task.spawn(function()

    while ScreenGui.Parent do

        if Settings.AutoQuests then

            local actions =
                getRequiredQuestActions()


            if actions then

                local didSomething =
                    false


                -- =============================================
                -- HATCHING
                -- =============================================

                -- If a rarity quest exists, City is used.
                -- It also progresses total egg quests.

                if actions.RarityHatch then

                    runAction(
                        "QuestHatch",

                        function()

                            QuestHatch(
                                RARITY_EGG
                            )

                        end
                    )


                    didSomething =
                        true


                elseif actions.Eggs then

                    runAction(
                        "QuestHatch",

                        function()

                            QuestHatch(
                                NORMAL_EGG
                            )

                        end
                    )


                    didSomething =
                        true

                end


                -- =============================================
                -- BOOSTS
                -- =============================================

                if actions.Boosts then

                    runAction(
                        "QuestBoost",

                        function()

                            QuestUseBoost()

                        end
                    )


                    didSomething =
                        true

                end


                -- =============================================
                -- POTIONS
                -- =============================================

                if actions.Potions then

                    runAction(
                        "QuestPotion",

                        function()

                            QuestUsePotion()

                        end
                    )


                    didSomething =
                        true

                end


                -- =============================================
                -- FRUITS
                -- =============================================

                if actions.Fruits then

                    runAction(
                        "QuestFruit",

                        function()

                            QuestUseFruit()

                        end
                    )


                    didSomething =
                        true

                end


                -- =============================================
                -- AURAS
                -- =============================================

                if actions.Auras then

                    runAction(
                        "QuestAura",

                        function()

                            QuestRollAura()

                        end
                    )


                    didSomething =
                        true

                end


                -- =============================================
                -- CRATES
                -- =============================================

                if actions.Crates then

                    runAction(
                        "QuestCrate",

                        function()

                            QuestOpenCrate()

                        end
                    )


                    didSomething =
                        true

                end


                -- =============================================
                -- GOLD
                -- =============================================

                if actions.Gold then

                    local now =
                        os.clock()


                    if now -
                        LastGoldCraft
                        >= CRAFT_DELAY
                    then

                        LastGoldCraft =
                            now


                        runAction(
                            "QuestGold",

                            function()

                                QuestCraft(
                                    "Gold"
                                )

                            end
                        )

                    end


                    didSomething =
                        true

                end


                -- =============================================
                -- RAINBOW
                -- =============================================

                if actions.Rainbow then

                    local now =
                        os.clock()


                    if now -
                        LastRainbowCraft
                        >= CRAFT_DELAY
                    then

                        LastRainbowCraft =
                            now


                        runAction(
                            "QuestRainbow",

                            function()

                                QuestCraft(
                                    "Rainbow"
                                )

                            end
                        )

                    end


                    didSomething =
                        true

                end


                -- =============================================
                -- WAIT
                -- =============================================

                if didSomething then

                    task.wait(
                        QUEST_ACTION_DELAY
                    )

                else

                    task.wait(0.5)

                end

            else

                task.wait(1)

            end

        else

            task.wait(0.25)

        end

    end

end)
