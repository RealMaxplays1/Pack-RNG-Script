            task.wait(IDLE_DELAY)
            continue

        end


        local egg = nil


        if QuestState.SecretHatch then

            egg =
                SECRET_EGG


        elseif QuestState.EternalHatch then

            egg =
                ETERNAL_EGG


        elseif QuestState.Eggs then

            egg =
                NORMAL_EGG

        end


        if not egg then

            task.wait(0.5)
            continue

        end


        pcall(function()

            Functions
                :WaitForChild("Hatch")
                :InvokeServer(
                    egg,
                    "Triple"
                )

        end)


        task.wait(
            QUEST_HATCH_DELAY
        )

    end

end)


