--// =========================================================
--// QUEST AURAS
--//
--// EXACT PRIORITY:
--//
--// 1. Basic
--// 2. Epic
--// 3. Icy
--// 4. Emerald
--// 5. Magma
--// 6. Galaxy
--//
--// Always starts at Basic.
--// Only tries the next tier if the current
--// one is unavailable.
--// =========================================================

task.spawn(function()

    while alive do

        if not Settings.AutoQuests
            or not QuestState.Auras then

            task.wait(IDLE_DELAY)
            continue

        end


        for _, aura in ipairs(AuraPriority) do

            if not alive
                or not Settings.AutoQuests
                or not QuestState.Auras then

                break
            end


            local success, result =
                pcall(function()

                    return Functions
                        :WaitForChild("AurasFunction")
                        :InvokeServer(aura)

                end)


            -- SUCCESS:
            -- stop immediately.
            --
            -- Next cycle starts from Basic again.
            if success
                and result ~= false then

                break
            end


            -- FALSE / ERROR:
            -- current tier isn't available,
            -- so continue:
            --
            -- Basic -> Epic -> Icy ->
            -- Emerald -> Magma -> Galaxy

        end


        task.wait(
            QUEST_AURA_DELAY
        )

    end

end)


