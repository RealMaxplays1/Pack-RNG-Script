--// =========================================================
--// EXACT ActivePotions TIMER SEARCH
--//
--// REAL STRUCTURE FOUND:
--//
--// ActivePotions
--//   .gemsMultiplier
--//      .gems
--//         .endsAt
--//
--// ActivePotions
--//   .clicksMultiplier
--//      .apple
--//         .endsAt
--// =========================================================

local function findActivePotionEndsAt(
    tbl,
    itemName,
    depth,
    visited
)

    if type(tbl) ~= "table" then
        return nil
    end


    depth =
        depth or 0


    visited =
        visited or {}


    if depth > 8
        or visited[tbl] then

        return nil

    end


    visited[tbl] =
        true


    local target =
        normalize(
            itemName
        )


    local bestEndsAt =
        nil


    for key, value in pairs(tbl) do

        if normalize(key) ==
            target
            and type(value) ==
            "table" then


            local endsAt =
                tonumber(
                    value.endsAt
                    or value.endAt
                    or value.EndsAt
                    or value.EndAt
                )


            if endsAt ~= nil then

                if bestEndsAt ==
                    nil
                    or endsAt >
                    bestEndsAt then

                    bestEndsAt =
                        endsAt

                end

            end

        end


        if type(value) ==
            "table" then

            local result =
                findActivePotionEndsAt(
                    value,
                    itemName,
                    depth + 1,
                    visited
                )


            if result ~= nil then

                if bestEndsAt ==
                    nil
                    or result >
                    bestEndsAt then

                    bestEndsAt =
                        result

                end

            end

        end

    end


    return bestEndsAt

end


--// =========================================================
--// EXACT ACTIVE STATE
--//
--// true  = ACTIVE
--// false = NOT ACTIVE
--// nil   = CAN'T READ DATA
--// =========================================================

local function getExactBoostActiveState(
    itemName
)

    if not QuestReplica
        or not QuestReplica.Data then

        return nil, nil

    end


    local activePotions =
        QuestReplica.Data.ActivePotions


    if type(activePotions) ~=
        "table" then

        return nil, nil

    end


    local endsAt =
        findActivePotionEndsAt(
            activePotions,
            itemName,
            0,
            {}
        )


    -- ActivePotions exists, but this item
    -- does not have an active entry.
    if endsAt == nil then

        return false, nil

    end


    if endsAt >
        os.time() then

        return true, endsAt

    end


    return false, endsAt

end


--// =========================================================
--// EXACT BOOST INFO
--// =========================================================

local function getExactBoostInfo(
    itemName
)

    if not ensureQuestReplica(
        true
    ) then

        return nil, nil, nil

    end


    local owned =
        getOwnedBoostAmount(
            itemName
        )


    local active,
        endsAt =
        getExactBoostActiveState(
            itemName
        )


    return owned,
        active,
        endsAt

end


--// =========================================================
--// AUTO BOOST DOUBLE-USE LOCK
--// =========================================================

local BoostUseLocks = {}


local function boostLocked(
    itemName
)

    local untilTime =
        BoostUseLocks[
            itemName
        ]


    return untilTime ~= nil
        and os.clock() <
        untilTime

end


local function lockBoost(
    itemName
)

    BoostUseLocks[
        itemName
    ] =
        os.clock() + 1.5

end


--// =========================================================
--// AUTO BOOST USE
--//
--// ONLY USE WHEN:
--//
--// OWNED > 0
--// AND
--// ACTIVE == FALSE
--//
--// This helper is ONLY for Auto Boosts.
--// =========================================================

local function useOnlyIfInactive(
    itemName
)

    if boostLocked(
        itemName
    ) then

        return false

    end


    local owned,
        active =
        getExactBoostInfo(
            itemName
        )


    if owned == nil
        or owned <= 0 then

        return false

    end


    if active ~= false then

        return false

    end


    -- Re-check immediately before consuming.
    local secondCheck =
        getExactBoostActiveState(
            itemName
        )


    if secondCheck ~=
        false then

        return false

    end


    lockBoost(
        itemName
    )


    Events
        :WaitForChild("UsePotion")
        :FireServer(
            itemName,
            1
        )


    print(
        "[Auto Boosts] USED:",
        itemName
    )


    return true

end


