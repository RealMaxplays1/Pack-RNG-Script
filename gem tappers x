local function formatNumber(
    number
)

    if number == nil then
        return "?"
    end


    number =
        math.floor(
            number
        )


    local formatted =
        tostring(
            number
        )


    while true do

        local newFormatted,
            replacements =
            string.gsub(
                formatted,
                "^(-?%d+)(%d%d%d)",
                "%1,%2"
            )


        formatted =
            newFormatted


        if replacements ==
            0 then

            break

        end

    end


    return formatted

end


local function initializeSessionStats()

    if SessionBaseline.Initialized then
        return true
    end


    local replica =
        ensureQuestReplica(
            true
        )


    if not replica then
        return false
    end


    local eggs,
        secrets,
        divines =
        getRawHatchStats()


    if eggs == nil
        and secrets == nil
        and divines == nil then

        return false

    end


    SessionBaseline.Eggs =
        eggs or 0


    SessionBaseline.Secrets =
        secrets or 0


    SessionBaseline.Divines =
        divines or 0


    SessionBaseline.Initialized =
        true


    return true

end


local function updateStats()

    StatsUpdated.Text =
        "Updating..."


    if not initializeSessionStats() then

        StatsUpdated.Text =
            "Waiting for stats..."


        return

    end


    local currentEggs,
        currentSecrets,
        currentDivines =
        getRawHatchStats()


    local sessionEggs =
        math.max(
            0,
            (currentEggs or SessionBaseline.Eggs)
            - SessionBaseline.Eggs
        )


    local sessionSecrets =
        math.max(
            0,
            (currentSecrets or SessionBaseline.Secrets)
            - SessionBaseline.Secrets
        )


    local sessionDivines =
        math.max(
            0,
            (currentDivines or SessionBaseline.Divines)
            - SessionBaseline.Divines
        )


    EggsStat.Text =
        "Eggs: +" ..
        formatNumber(
            sessionEggs
        )


    SecretStat.Text =
        "Secrets: +" ..
        formatNumber(
            sessionSecrets
        )


    DivineStat.Text =
        "Divines: +" ..
        formatNumber(
            sessionDivines
        )


    StatsUpdated.Text =
        "Session • updates every 60s"

end


