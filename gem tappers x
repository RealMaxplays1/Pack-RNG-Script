--// =========================================================
--// PROCESS QUEST
--// =========================================================

local function processQuest(
    quest
)

    if type(quest) ~= "table" then
        return false
    end

    local questInfo =
        SeasonQuests
            .getQuestData(
                quest.Id
            )

    if not questInfo then
        return false
    end


    local dataType =
        questInfo.dataType


    -- ==========================================
    -- IGNORE TIME PLAYED
    -- ==========================================

    if dataType ==
        "TimePlayed" then

        return false

    end


    -- ==========================================
    -- IGNORE CLICK QUESTS
    -- ==========================================

    if dataType ==
        "UniqueClicks" then

        return false

    end


    -- ==========================================
    -- ALREADY COMPLETE
    -- ==========================================

    if questComplete(
        quest,
        questInfo
    ) then

        return false

    end


    -- ==========================================
    -- BOOSTS
    -- ==========================================

    if dataType ==
        "BoostsUsed" then

        QuestUseItem(
            BOOST_ITEM
        )

        return true

    end


    -- ==========================================
    -- NORMAL EGG QUEST
    -- ==========================================

    if dataType ==
        "Eggs" then

        QuestHatch(
            NORMAL_EGG
        )

        return true

    end


    -- ==========================================
    -- ETERNAL PETS
    -- ==========================================

    if dataType ==
        "EternalHatched" then

        QuestHatch(
            RARITY_EGG
        )

        return true

    end


    -- ==========================================
    -- MYTHICAL PETS
    -- ==========================================

    if dataType ==
        "MythicalHatched" then

        QuestHatch(
            RARITY_EGG
        )

        return true

    end


    -- ==========================================
    -- SECRET PETS
    -- ==========================================

    if dataType ==
        "SecretHatched" then

        QuestHatch(
            RARITY_EGG
        )

        return true

    end


    -- ==========================================
    -- AURA QUEST
    -- ==========================================

    if dataType ==
        "AuraChestsOpened" then

        QuestRollAura()

        return true

    end


    -- ==========================================
    -- GOLD PETS
    -- ==========================================

    if dataType ==
        "ShinyCrafted" then

        local questKey =
            "Gold_"
            .. tostring(
                quest.Id
            )
            .. "_"
            .. tostring(
                quest.endAmount
            )

        if not CraftTriggered[
            questKey
        ] then

            CraftTriggered[
                questKey
            ] = true

            QuestCraft("Gold")

        end

        return true

    end


    -- ==========================================
    -- RAINBOW PETS
    -- ==========================================

    if dataType ==
        "RainbowCrafted" then

        local questKey =
            "Rainbow_"
            .. tostring(
                quest.Id
            )
            .. "_"
            .. tostring(
                quest.endAmount
            )

        if not CraftTriggered[
            questKey
        ] then

            CraftTriggered[
                questKey
            ] = true

            QuestCraft(
                "Rainbow"
            )

        end

        return true

    end


    -- ==========================================
    -- CRATES
    -- ==========================================

    if dataType ==
        "TotalCratesOpened" then

        QuestOpenCrate()

        return true

    end


    -- ==========================================
    -- FRUITS
    -- ==========================================

    if dataType ==
        "TotalFruitsUsed" then

        QuestUseItem(
            FRUIT_ITEM
        )

        return true

    end


    return false

end


--// =========================================================
--// AUTO QUEST LOOP
--// =========================================================

task.spawn(function()

    while ScreenGui.Parent do

        if Settings.AutoQuests then

            local quests =
                getCurrentQuests()

            if quests then

                local didAction =
                    false

                for _, quest in pairs(quests) do

                    if not Settings.AutoQuests
                        or not ScreenGui.Parent then

                        break
                    end

                    local success =
                        processQuest(
                            quest
                        )

                    if success then

                        didAction =
                            true

                        -- Do one quest action
                        -- then re-check data
                        break

                    end

                end

                if didAction then

                    task.wait(
                        QUEST_ACTION_DELAY
                    )

                else

                    task.wait(0.5)

                end

            else

                task.wait(1)

            end

        else

            task.wait(0.25)

        end

    end

end)
